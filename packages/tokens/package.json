{
  "name": "@nds/tokens",
  "version": "0.1.0",
  "private": false,
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build:primitives": "style-dictionary build --config style-dictionary.config.mjs",
    "build:categorical:light": "style-dictionary build --config style-dictionary.categorical.light.config.mjs",
    "build:categorical:dark": "style-dictionary build --config style-dictionary.categorical.dark.config.mjs",
    "build": "npm run build:primitives && npm run build:categorical:light && npm run build:categorical:dark && node scripts/combine-tokens-css.mjs"
  },
  "devDependencies": {
    "style-dictionary": "latest"
  }
}
